{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "webCut",
  "version": "0.6.4",
  "identifier": "com.feeday.webcut",
  "build": {
    "beforeBuildCommand": "npm run prepare:web",
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "webCut",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
